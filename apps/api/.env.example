# Run from apps/api. Copy to .env for local development.
API_HOST=127.0.0.1
API_PORT=8080
# Private persistent directory, relative to the API working directory.
DATA_DIR=.data
ROOM_CODE_LENGTH=4
PUBLIC_ORIGIN=http://localhost:5173
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# Production: set both origins to exact HTTPS origins and run with --env production.
# No trailing slash or URL path. Never expose DATA_DIR as static files.

# <=1 MiB prefers RAM; 64 MiB aggregate reservations + retained RAM files.
# Pool full => disk. Set MEMORY_FILE_BYTES=0 to make all files durable on disk.
MEMORY_FILE_BYTES=1048576
MEMORY_TOTAL_BYTES=67108864
