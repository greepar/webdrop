# Reference only: the executable generates its own .env on first launch and exits.
# Review/edit that file, then start again. Existing .env files are never overwritten.
API_HOST=127.0.0.1
API_PORT=8080
# Private persistent directory, relative to the API working directory.
DATA_DIR=.data
ROOM_CODE_LENGTH=4
# Active room limit (1..1000000); per-session owner limit (1..MAX_ROOMS).
# Without MAX_OWNED_ROOMS the default is min(5, MAX_ROOMS). Restart to apply.
MAX_ROOMS=500
MAX_OWNED_ROOMS=5
# Embedded frontend and API share API_PORT. Links use the actual request origin.
# Proxies must preserve Host and overwrite X-Forwarded-Proto with the external scheme.
# Optional explicit cross-origin frontend origins, comma separated. Empty = same-origin only.
CORS_ALLOWED_ORIGINS=
# Run with --env production for HTTPS deployment / Secure cookies.
# Never expose DATA_DIR as static files.

# <=1 MiB prefers RAM; 64 MiB aggregate reservations + retained RAM files.
# Pool full => disk. Set MEMORY_FILE_BYTES=0 to make all files durable on disk.
MEMORY_FILE_BYTES=1048576
MEMORY_TOTAL_BYTES=67108864
